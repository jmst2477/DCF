{
  "functions": {
    "api/kakao.js": {
      "includeFiles": "js/**",
      "maxDuration": 60
    },
    "api/agent.js": {
      "includeFiles": "js/**",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/kakao?action=cron",
      "schedule": "0 22 * * 1-5"
    },
    {
      "path": "/api/agent?action=cron&step=close",
      "schedule": "30 22 * * 1-5"
    },
    {
      "path": "/api/agent?action=cron&step=scan",
      "schedule": "30 23 * * 1-5"
    },
    {
      "path": "/api/agent?action=cron&step=swap",
      "schedule": "0 15 * * 1-5"
    },
    {
      "path": "/api/agent?action=cron&step=krswap",
      "schedule": "10 0 * * 1-5"
    },
    {
      "path": "/api/agent?action=cron&step=krswap",
      "schedule": "0 5 * * 1-5"
    },
    {
      "path": "/api/agent?action=cron&step=open",
      "schedule": "0 2 * * 1-5"
    },
    {
      "path": "/api/agent?action=cron&step=krclose",
      "schedule": "50 22 * * 1-5"
    },
    {
      "path": "/api/agent?action=cron&step=krnxt",
      "schedule": "1 23 * * 0-4"
    },
    {
      "path": "/api/agent?action=cron&step=kropen",
      "schedule": "40 23 * * 0-4"
    },
    {
      "path": "/api/kakao?action=report",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/kakao?action=news",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/kakao?action=discover",
      "schedule": "0 20 * * 1"
    }
  ],
  "rewrites": [
    {
      "source": "/r/:id",
      "destination": "/api/kakao?view=:id"
    },
    {
      "source": "/d/:id",
      "destination": "/api/kakao?deep=:id"
    }
  ]
}
